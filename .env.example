# ==============================================================================
# MyFinancialFlow — Reference Configuration (Zero-Build-Time Architecture)
# ==============================================================================
# PENTING: MyFinancialFlow didesain dengan arsitektur Zero-Build-Time.
# Kredensial dan API key TIDAK di-compile ke dalam kode web saat build!
#
# Seluruh konfigurasi di bawah ini diisi langsung oleh pengguna di browser
# melalui menu: Settings (Pengaturan) di dalam aplikasi MyFinancialFlow.
# Nilai disimpan secara aman dan terenkripsi di IndexedDB lokal browser Anda.
#
# File .env ini disediakan sebagai referensi checklist persiapan kredensial Anda.
# Panduan lengkap: lihat INSTALLATION.md atau INSTALLATION.id.md
# ==============================================================================

# 1. Google Drive Cloud Sync (Settings -> Cloud Sync)
# Dapatkan dari: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client ID
# Format: XXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 2. AI Assistant Providers (Settings -> AI Assistant & OCR)
# Groq API Key (Gratis & Super Cepat): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini API Key (Multimodal OCR & Vision): https://aistudio.google.com/
GEMINI_API_KEY=
# OpenRouter API Key (Gateway Cadangan): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Telegram Bot Ingestion (Settings -> Telegram Bot)
# Token bot dari @BotFather di Telegram:
TELEGRAM_BOT_TOKEN=
# URL Worker Relay Anda:
TELEGRAM_RELAY_URL=https://financeflow-relay.<subdomain>.workers.dev
# PIN Enkripsi Pesan (4-6 digit angka pilihan Anda):
TELEGRAM_SECURITY_PIN=

# 4. Opt-In Anonymous Crash Telemetry (Settings -> Privacy & Telemetry)
TELEMETRY_WORKER_URL=https://financeflow-telemetry.<subdomain>.workers.dev
